[internationalization]

locale/translations=PackedStringArray("res://config/localization/strings_en.csv", "res://config/localization/strings_nl.csv")
locale/translations_pot_files=PackedStringArray("res://config/localization/strings_en.csv", "res://config/localization/strings_nl.csv")
locale/include_text_server_data=true

[rendering]

textures/canvas_textures/default_texture_filter=2
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_environment="res://config/default_environment.tres"
2d/use_pixel_snap=true

[layer_names]

2d_render/layer_1="UI"
2d_render/layer_2="Tooltips"
2d_render/layer_3="Dialogs"
2d_render/layer_4="Debug"

[physics]

common/enable_pause_aware_picking=true

[debug]

gdscript/warnings/enable=true
gdscript/warnings/treat_warnings_as_errors=false
gdscript/warnings/exclude_addons=true

# Performance monitoring for constitutional requirement: 60 FPS target
settings/fps_limit=60
settings/vsync/use_vsync=true

# Accessibility settings for constitutional requirement: WCAG 2.1 AA compliance
accessibility/high_contrast=false
accessibility/text_scale=1.0
accessibility/screen_reader_enabled=false