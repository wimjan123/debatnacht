; Engine configuration file.
; It's best edited using the editor UI and not directly,
; unless you know what you are doing.

[application]

config/name="Dutch Politics Simulation"
config/description="Educational political simulation demonstrating democratic processes in the Netherlands with full constitutional compliance: transparency, educational purpose, political neutrality, accessibility, and technical integrity."
run/main_scene="res://ui/scenes/main_menu/MainMenu.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://ui/icon.svg"

[autoload]

EventBus="*res://presentation/managers/event_bus.gd"
GameStateManager="*res://presentation/state_managers/game_state_manager.gd"
UIStateManager="*res://presentation/state_managers/ui_state_manager.gd"
AccessibilityManager="*res://presentation/managers/accessibility_manager.gd"
LocalizationManager="*res://presentation/managers/localization_manager.gd"
ObjectPool="*res://presentation/managers/object_pool.gd"
PerformanceMonitor="*res://presentation/managers/performance_monitor.gd"
SceneManager="*res://presentation/managers/scene_manager.gd"
InputHandler="*res://presentation/managers/input_handler.gd"
LoggingManager="*res://presentation/managers/logging_manager.gd"
RNGValidator="*res://presentation/managers/rng_validator.gd"
SaveLoadManager="*res://presentation/managers/save_load_manager.gd"
UndoRedoManager="*res://presentation/managers/undo_redo_manager.gd"

[audio]

buses/default_bus_layout="res://config/default_bus_layout.tres"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui/themes/default_theme.tres"
common/drop_mouse_on_gui_input_disabled=true

